{
  "name": "FinSight Executive Dark",
  "dataColors": [
    "#0EA5E9",
    "#10B981",
    "#F59E0B",
    "#EF4444",
    "#8B5CF6",
    "#EC4899",
    "#06B6D4",
    "#84CC16"
  ],
  "background": "#0F172A",
  "foreground": "#F8FAFC",
  "tableAccent": "#0EA5E9",
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "color": {"solid": {"color": "#1E293B"}},
            "transparency": 10
          }
        ],
        "border": [
          {
            "show": true,
            "color": {"solid": {"color": "#334155"}},
            "radius": 8
          }
        ],
        "dropShadow": [
          {
            "show": true,
            "color": {"solid": {"color": "#000000"}},
            "position": "Outer",
            "preset": "BottomRight"
          }
        ],
        "title": [
          {
            "show": true,
            "fontColor": {"solid": {"color": "#F8FAFC"}},
            "fontSize": 12,
            "fontFamily": "Segoe UI Semibold"
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "color": {"solid": {"color": "#38BDF8"}},
            "fontSize": 20,
            "fontFamily": "Segoe UI Bold"
          }
        ],
        "categoryLabels": [
          {
            "color": {"solid": {"color": "#94A3B8"}},
            "fontSize": 10
          }
        ]
      }
    }
  }
}
