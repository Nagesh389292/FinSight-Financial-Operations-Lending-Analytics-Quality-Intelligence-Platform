      {
        "name": "_Measures",
        "columns": [
          {
            "name": "Measure",
            "dataType": "string",
            "isHidden": true,
            "lineageTag": "d8a83217-9aae-457a-8713-1570a810912d",
            "sourceColumn": "Measure",
            "summarizeBy": "none"
          }
        ],
        "lineageTag": "e10c6f0a-a70a-4c56-af64-ece2ffd249ca",
        "measures": [
          {
            "name": "Total Loans",
            "displayFolder": "01_Portfolio_Lending",
            "expression": "DISTINCTCOUNT(dim_loan[loan_id])",
            "formatString": "#,##0",
            "lineageTag": "bcd9bafe-da51-452e-8ed3-ce75e7c6e947"
          },
          {
            "name": "Original Principal",
            "displayFolder": "01_Portfolio_Lending",
            "expression": "SUM(dim_loan[original_principal])",
            "formatString": "$#,##0.00",
            "lineageTag": "311b64d8-9f3a-4a1e-b21b-37ec7992cd5a"
          },
          {
            "name": "Outstanding Principal",
            "displayFolder": "01_Portfolio_Lending",
            "expression": "SUM(fact_loan_performance[outstanding_principal])",
            "formatString": "$#,##0.00",
            "lineageTag": "dca99e57-0386-40ab-803e-7a748890c512"
          },
          {
            "name": "Average Facility Size",
            "displayFolder": "01_Portfolio_Lending",
            "expression": "DIVIDE([Outstanding Principal], [Total Loans], 0)",
            "formatString": "$#,##0.00",
            "lineageTag": "341d8466-3362-47d4-bee3-ee1cc77c0e07"
          },
          {
            "name": "Active Loans",
            "displayFolder": "01_Portfolio_Lending",
            "expression": [
              "CALCULATE(",
              "    [Total Loans],",
              "    fact_loan_performance[status] = \"ACTIVE\"",
              ")"
            ],
            "formatString": "#,##0",
            "lineageTag": "0870255c-319f-4e4d-b5ec-aa9d53870a7b"
          },
          {
            "name": "Weighted Average Rate (WAR)",
            "displayFolder": "01_Portfolio_Lending",
            "expression": [
              "DIVIDE(",
              "    SUMX(dim_loan, dim_loan[original_principal] * dim_loan[annual_interest_rate]),",
              "    [Original Principal],",
              "    0",
              ")"
            ],
            "formatString": "0.00%",
            "lineageTag": "0671b1eb-cbcb-4ba1-9f13-bc8b1c024b61"
          },
          {
            "name": "Total Payment Volume",
            "displayFolder": "02_Payments_CashFlow",
            "expression": "SUM(fact_payment[payment_amount])",
            "formatString": "$#,##0.00",
            "lineageTag": "0ba56ebd-a167-4006-88d0-8cfafdacf28d"
          },
          {
            "name": "Principal Collected",
            "displayFolder": "02_Payments_CashFlow",
            "expression": "SUM(fact_payment[principal_applied])",
            "formatString": "$#,##0.00",
            "lineageTag": "d0f2847f-254e-47ff-b1b5-afa8cfd18c92"
          },
          {
            "name": "Interest Collected",
            "displayFolder": "02_Payments_CashFlow",
            "expression": "SUM(fact_payment[interest_applied])",
            "formatString": "$#,##0.00",
            "lineageTag": "475e328e-5ee2-40ab-8f0d-afbba6801053"
          },
          {
            "name": "Fees Collected",
            "displayFolder": "02_Payments_CashFlow",
            "expression": "SUM(fact_payment[fees_applied])",
            "formatString": "$#,##0.00",
            "lineageTag": "9966c43d-6416-402f-9c19-9dc09118a251"
          },
          {
            "name": "Prepayments Collected",
            "displayFolder": "02_Payments_CashFlow",
            "expression": "SUM(fact_payment[prepayment_applied])",
            "formatString": "$#,##0.00",
            "lineageTag": "293f9039-ce93-4bfe-8c43-15d397254a61"
          },
          {
            "name": "Total Scheduled Due",
            "displayFolder": "02_Payments_CashFlow",
            "expression": "SUM(fact_loan_performance[total_due])",
            "formatString": "#,##0",
            "lineageTag": "0c2aec5b-4ead-430a-b131-84265af75669"
          },
          {
            "name": "Collection Efficiency %",
            "displayFolder": "02_Payments_CashFlow",
            "expression": "DIVIDE([Total Payment Volume], [Total Scheduled Due], 0)",
            "formatString": "0.00%",
            "lineageTag": "298b460f-9219-4fed-8811-57f5c51bf52a"
          },
          {
            "name": "Delinquent Balance (30+ DPD)",
            "displayFolder": "03_Delinquency_Risk",
            "expression": [
              "CALCULATE(",
              "    [Outstanding Principal],",
              "    fact_loan_performance[is_delinquent_30_plus] = TRUE()",
              ")"
            ],
            "formatString": "$#,##0.00",
            "lineageTag": "9e76698f-5f4d-47fa-9e7b-72732601f022"
          },
          {
            "name": "Default Balance (90+ DPD)",
            "displayFolder": "03_Delinquency_Risk",
            "expression": [
              "CALCULATE(",
              "    [Outstanding Principal],",
              "    fact_loan_performance[is_default_90_plus] = TRUE()",
              ")"
            ],
            "formatString": "$#,##0.00",
            "lineageTag": "ab5515a2-2cdf-4d8a-ad38-b517e81a091f"
          },
          {
            "name": "Delinquency Rate (30+ DPD)",
            "displayFolder": "03_Delinquency_Risk",
            "expression": "DIVIDE([Delinquent Balance (30+ DPD)], [Outstanding Principal], 0)",
            "formatString": "0.00%",
            "lineageTag": "25814668-26d4-4258-bbf8-a7085dd0df04"
          },
          {
            "name": "Default Rate (90+ DPD)",
            "displayFolder": "03_Delinquency_Risk",
            "expression": "DIVIDE([Default Balance (90+ DPD)], [Outstanding Principal], 0)",
            "formatString": "0.00%",
            "lineageTag": "43bb5964-a8b5-47ff-9d10-f0a6801b97ec"
          },
          {
            "name": "Current Performing Balance",
            "displayFolder": "03_Delinquency_Risk",
            "expression": [
              "CALCULATE(",
              "    [Outstanding Principal],",
              "    fact_loan_performance[days_past_due] < 30",
              ")"
            ],
            "formatString": "$#,##0.00",
            "lineageTag": "073f5421-6103-42dd-a17d-dfdec163fc8c"
          },
          {
            "name": "Current Performing Rate %",
            "displayFolder": "03_Delinquency_Risk",
            "expression": "DIVIDE([Current Performing Balance], [Outstanding Principal], 0)",
            "formatString": "0.00%",
            "lineageTag": "d89cc202-2fad-4551-84f6-3cc69ef3d9f9"
          },
          {
            "name": "Total Debits",
            "displayFolder": "04_Financial_GL",
            "expression": "SUM(fact_financial[total_debit])",
            "formatString": "$#,##0.00",
            "lineageTag": "7d132a36-d792-49d8-94b5-a6d7c3d6e172"
          },
          {
            "name": "Total Credits",
            "displayFolder": "04_Financial_GL",
            "expression": "SUM(fact_financial[total_credit])",
            "formatString": "$#,##0.00",
            "lineageTag": "318e072c-43e7-4c92-933c-3c2ac686c41f"
          },
          {
            "name": "Net GL Movement",
            "displayFolder": "04_Financial_GL",
            "expression": "SUM(fact_financial[net_movement])",
            "formatString": "$#,##0.00",
            "lineageTag": "287f2fc0-face-446c-850c-8e2d8c638f12"
          },
          {
            "name": "GL Variance (Debit - Credit)",
            "displayFolder": "04_Financial_GL",
            "expression": "ABS([Total Debits] - [Total Credits])",
            "formatString": "$#,##0.00",
            "lineageTag": "e3faddd5-5d69-43b8-adf5-a8dc923c8b80"
          },
          {
            "name": "Total Interest Income Accrued",
            "displayFolder": "04_Financial_GL",
            "expression": "SUM(fact_loan_performance[accrued_interest])",
            "formatString": "$#,##0.00",
            "lineageTag": "3675ef91-8931-4f22-b281-d805d86fea47"
          },
          {
            "name": "Net Interest Margin % (NIM)",
            "displayFolder": "04_Financial_GL",
            "expression": "DIVIDE([Total Interest Income Accrued] * 12, [Outstanding Principal], 0)",
            "formatString": "0.00%",
            "lineageTag": "47ef1b8e-a690-44dd-bf50-2a74de45efa0"
          },
          {
            "name": "Total Defects",
            "displayFolder": "05_QA_Defects",
            "expression": "COUNTROWS(fact_defect)",
            "formatString": "#,##0",
            "lineageTag": "6d415edf-0236-4a55-953c-809cede70fe3"
          },
          {
            "name": "Critical Defects",
            "displayFolder": "05_QA_Defects",
            "expression": [
              "CALCULATE(",
              "    [Total Defects],",
              "    fact_defect[severity] = \"CRITICAL\"",
              ")"
            ],
            "formatString": "#,##0",
            "lineageTag": "404b6af2-0c5a-4f35-bf2b-4f2ad1651375"
          },
          {
            "name": "Major Defects",
            "displayFolder": "05_QA_Defects",
            "expression": [
              "CALCULATE(",
              "    [Total Defects],",
              "    fact_defect[severity] = \"MAJOR\"",
              ")"
            ],
            "formatString": "#,##0",
            "lineageTag": "5efcd42a-894b-41f8-b249-fc15606867b6"
          },
          {
            "name": "Minor Defects",
            "displayFolder": "05_QA_Defects",
            "expression": [
              "CALCULATE(",
              "    [Total Defects],",
              "    fact_defect[severity] = \"MINOR\"",
              ")"
            ],
            "formatString": "#,##0",
            "lineageTag": "b83ef7f8-7c07-46c8-a042-99ddaea27a99"
          },
          {
            "name": "P1 Defects",
            "displayFolder": "05_QA_Defects",
            "expression": [
              "CALCULATE(",
              "    [Total Defects],",
              "    fact_defect[priority] = \"P1\"",
              ")"
            ],
            "formatString": "#,##0",
            "lineageTag": "bca74bc9-4b75-4979-9d50-45f071ca7e92"
          },
          {
            "name": "P2 Defects",
            "displayFolder": "05_QA_Defects",
            "expression": [
              "CALCULATE(",
              "    [Total Defects],",
              "    fact_defect[priority] = \"P2\"",
              ")"
            ],
            "formatString": "#,##0",
            "lineageTag": "e5640efc-8b11-4a1d-8a3f-0bf07d3e0176"
          },
          {
            "name": "P3 Defects",
            "displayFolder": "05_QA_Defects",
            "expression": [
              "CALCULATE(",
              "    [Total Defects],",
              "    fact_defect[priority] = \"P3\"",
              ")"
            ],
            "formatString": "#,##0",
            "lineageTag": "d2284f58-fb31-4e73-bed0-4db7f26c9776"
          },
          {
            "name": "Open Defects",
            "displayFolder": "05_QA_Defects",
            "expression": [
              "CALCULATE(",
              "    [Total Defects],",
              "    NOT(fact_defect[status] IN {\"RESOLVED\", \"VERIFIED_CLOSED\"})",
              ")"
            ],
            "formatString": "#,##0",
            "lineageTag": "79573ae2-0294-45eb-8615-eed82af02d5b"
          },
          {
            "name": "Resolved Defects",
            "displayFolder": "05_QA_Defects",
            "expression": [
              "CALCULATE(",
              "    [Total Defects],",
              "    fact_defect[status] IN {\"RESOLVED\", \"VERIFIED_CLOSED\"}",
              ")"
            ],
            "formatString": "#,##0",
            "lineageTag": "bc550515-960e-4602-a3bb-dd6d4f13cba2"
          },
          {
            "name": "Defect Resolution Rate %",
            "displayFolder": "05_QA_Defects",
            "expression": "DIVIDE([Resolved Defects], [Total Defects], 0)",
            "formatString": "0.00%",
            "lineageTag": "cd55b420-5476-4dbb-82f0-477366728729"
          },
          {
            "name": "Servicing Operations",
            "displayFolder": "05_QA_Defects",
            "expression": "29741",
            "formatString": "0.00%",
            "lineageTag": "c58a7052-b5af-446a-b8e7-b85068a457b5"
          },
          {
            "name": "Defect Density per 1k Ops",
            "displayFolder": "05_QA_Defects",
            "expression": "DIVIDE([Total Defects], [Servicing Operations], 0) * 1000",
            "formatString": "#,##0",
            "lineageTag": "97b9540e-2479-4bf6-9eb5-d6b75ddeaf3a"
          },
          {
            "name": "Defect Injection Rate %",
            "displayFolder": "05_QA_Defects",
            "expression": "DIVIDE([Total Defects], [Servicing Operations], 0) * 100",
            "formatString": "0.00%",
            "lineageTag": "d65abade-37cc-4509-82fa-08b84edc8f7f"
          },
          {
            "name": "Total Financial Variance Exposure",
            "displayFolder": "05_QA_Defects",
            "expression": "SUM(fact_defect[variance_amount])",
            "formatString": "$#,##0.00",
            "lineageTag": "22e180fb-93f8-4a5a-a96c-40dc549fd4e2"
          },
          {
            "name": "Mean Time to Detect (MTTD Hours)",
            "displayFolder": "05_QA_Defects",
            "expression": "0.5",
            "formatString": "0.0",
            "lineageTag": "deae8fd1-df52-4a08-893c-2e4275f23142"
          },
          {
            "name": "Mean Time to Resolve (MTTR Hours)",
            "displayFolder": "05_QA_Defects",
            "expression": "53.06",
            "formatString": "0.0",
            "lineageTag": "940e9090-02ab-46c6-b564-bba1d4e5e077"
          },
          {
            "name": "Total DQ Rules Evaluated",
            "displayFolder": "06_DataQuality_SRE",
            "expression": "SUM(fact_data_quality[total_rules_evaluated])",
            "formatString": "#,##0",
            "lineageTag": "ab4f7820-dc44-415d-966a-5ee684bfc3ea"
          },
          {
            "name": "DQ Rules Passed",
            "displayFolder": "06_DataQuality_SRE",
            "expression": "SUM(fact_data_quality[rules_passed])",
            "formatString": "#,##0",
            "lineageTag": "1807a571-59d1-418d-8479-d25da9c67422"
          },
          {
            "name": "DQ Rules Failed",
            "displayFolder": "06_DataQuality_SRE",
            "expression": "SUM(fact_data_quality[rules_failed])",
            "formatString": "#,##0",
            "lineageTag": "6eea8ec4-d8e2-42f0-91d3-2143baa21663"
          },
          {
            "name": "Overall DQ Compliance %",
            "displayFolder": "06_DataQuality_SRE",
            "expression": "DIVIDE([DQ Rules Passed], [Total DQ Rules Evaluated], 1.0) * 100",
            "formatString": "0.00%",
            "lineageTag": "e5027c07-c1ba-4e74-a09f-1bb01ba64b60"
          },
          {
            "name": "Audited Records Count",
            "displayFolder": "06_DataQuality_SRE",
            "expression": "167175",
            "formatString": "#,##0",
            "lineageTag": "87467512-eb77-4f8b-978d-15770aa6f513"
          },
          {
            "name": "Governance Audit Trail Events",
            "displayFolder": "06_DataQuality_SRE",
            "expression": "200",
            "formatString": "#,##0",
            "lineageTag": "a40930c4-ffea-4251-a5d8-8684e8c70c8c"
          },
          {
            "name": "Outstanding Principal Prior Month",
            "displayFolder": "07_Time_Intelligence",
            "expression": [
              "CALCULATE(",
              "    [Outstanding Principal],",
              "    DATEADD(dim_date[full_date], -1, MONTH)",
              ")"
            ],
            "formatString": "$#,##0.00",
            "lineageTag": "85c63ee9-549e-401e-9dfd-09c6be7ea04e"
          },
          {
            "name": "Outstanding Principal MoM %",
            "displayFolder": "07_Time_Intelligence",
            "expression": [
              "DIVIDE(",
              "    [Outstanding Principal] - [Outstanding Principal Prior Month],",
              "    [Outstanding Principal Prior Month],",
              "    0",
              ")"
            ],
            "formatString": "0.00%",
            "lineageTag": "6e87010c-8bdc-46c7-8784-589bda8cc9d8"
          },
          {
            "name": "Total Payments Prior Month",
            "displayFolder": "07_Time_Intelligence",
            "expression": [
              "CALCULATE(",
              "    [Total Payment Volume],",
              "    DATEADD(dim_date[full_date], -1, MONTH)",
              ")"
            ],
            "formatString": "#,##0",
            "lineageTag": "8e542668-ca34-48dc-8209-a9cd712f9cf4"
          },
          {
            "name": "Total Payments MoM Change",
            "displayFolder": "07_Time_Intelligence",
            "expression": "[Total Payment Volume] - [Total Payments Prior Month]",
            "formatString": "#,##0",
            "lineageTag": "d4e43cc3-ffcc-4ce6-b99c-8520db80efe8"
          },
          {
            "name": "Baseline Portfolio 12M Forecast",
            "displayFolder": "08_Forecast_Scenario",
            "expression": "[Outstanding Principal] * POWER(1 + 0.005, 12)",
            "formatString": "$#,##0.00",
            "lineageTag": "87a938d2-cb9f-43d3-93eb-094c2ea5046d"
          },
          {
            "name": "Stress Scenario 1 Balance (+200bps Fed Shock)",
            "displayFolder": "08_Forecast_Scenario",
            "expression": "[Outstanding Principal] * (1 - 0.04)",
            "formatString": "$#,##0.00",
            "lineageTag": "9eff8f7d-c1f0-4646-8e06-14c4f1ce2889"
          },
          {
            "name": "Stress Scenario 2 Balance (Delinquency Spike 2x)",
            "displayFolder": "08_Forecast_Scenario",
            "expression": "[Delinquent Balance (30+ DPD)] * 2.0",
            "formatString": "$#,##0.00",
            "lineageTag": "0d420ba2-30c0-4c43-99c6-074882e669e0"
          },
          {
            "name": "Stress Loss Exposure ($)",
            "displayFolder": "08_Forecast_Scenario",
            "expression": "[Stress Scenario 2 Balance (Delinquency Spike 2x)] * 0.45",
            "formatString": "$#,##0.00",
            "lineageTag": "818f4731-0c3f-464f-a1c1-d0b495e87096"
          }
        ],
        "partitions": [
          {
            "name": "_Measures",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "    Source = #table(type table [Measure = text], {{\"Measures\"}})",
                "in",
                "    Source"
              ],
              "type": "m"
            }
          }
        ]
      },
