# ==============================================================================
# FinSight Enterprise — Environment Configuration (.env)
# ==============================================================================

# Application & Server
APP_ENV=development
APP_PORT=8000
SECRET_KEY=finsight-enterprise-super-secret-dev-key-change-in-production-2026
DEBUG=True

# Database Configuration (PostgreSQL OLTP + OLAP)
POSTGRES_USER=finsight_admin
POSTGRES_PASSWORD=finsight_secure_pass_2026
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=finsight_db
DATABASE_URL=postgresql://finsight_admin:finsight_secure_pass_2026@localhost:5432/finsight_db

# External Public Data Configuration
FRED_API_KEY=
CENSUS_API_KEY=
SEC_USER_AGENT=FinSightEnterprise contact@finsightbank.com

# Quality Engineering & Testing Settings
RECONCILIATION_TOLERANCE_DOLLARS=0.0100
MAX_DEFECT_AUTO_TRIAGE=True
ENABLE_CONTROLLED_ANOMALY_INJECTION=True

# Cloud Target (AWS Settings - For Reference)
AWS_REGION=us-east-1
S3_DATA_LAKE_BUCKET=finsight-data-lake-raw
